# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000

# API
GREENGAUGE_DATABASE_PATH=./data/greengauge.sqlite3
GREENGAUGE_CORS_ORIGINS=http://localhost:3000
GITHUB_REPOSITORY=rohanmalige/GreenGauge
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Recommendation engine. Keep this file local; never commit a real key.
OPENAI_API_KEY=
RECOMMENDATION_MODEL=gpt-5-nano-2025-08-07
GREENGAUGE_EMBEDDING_MODEL=text-embedding-3-small
GREENGAUGE_RECOMMENDATION_MIN_SIMILARITY=0.60
GREENGAUGE_RECOMMENDATION_MIN_SUCCESS_RATE=0.60

# MCP collector
GREENGAUGE_API_URL=http://localhost:8000
GREENGAUGE_MCP_API_KEY=

# USD per 1M tokens. Replace these placeholder rates with the exact provider/model prices used by your team.
GREENGAUGE_MODEL_PRICING_JSON={"terra":{"input":0.25,"cached_input":0.025,"cache_write":0.25,"output":1.5},"sonnet":{"input":3,"cached_input":0.3,"cache_write":3,"output":15},"sol":{"input":2.5,"cached_input":0.25,"cache_write":2.5,"output":15}}
